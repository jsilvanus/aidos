<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core permissions for Git repository access and offline operation -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    
    <!-- Required for foreground service (M27: RuntimeServiceHost, RFC-0050) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- The ongoing notification is a real UI surface (RFC-0050 "Notifications"), not optional
         chrome — targetSdk 33+ requires this to post any notification, including the foreground
         service's own. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional for voice features (M33) -->
    <!-- <uses-permission android:name="android.permission.RECORD_AUDIO" /> -->

    <application
        android:usesCleartextTraffic="false">

        <!-- Main activity for Aidos UI (M28, RFC-0050) -->
        <activity
            android:name="fi.italeino.aidos.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service for runtime (M27, RFC-0050, D24). Wraps the platform-neutral
             dev.aidos.androidapp.service.RuntimeServiceHost (jvmMain). "dataSync" is the closest
             standard Android 14 foreground-service-type match for "runs the agent loop the user
             started"; none of the standard types name this exactly. -->
        <service
            android:name="fi.italeino.aidos.service.AidosService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
