<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Custom permission for Binder handshake (RFC-0103).
         Only apps signed with the same certificate as Aidos Engine can call the handshake.
         The OS enforces this at install time via PackageManager. -->
    <permission
        android:name="fi.italeino.aidos.engine.HANDSHAKE"
        android:protectionLevel="signature"
        android:label="@string/permission_handshake_label"
        android:description="@string/permission_handshake_description" />

    <!-- Core permissions for model loading and inference -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Required for foreground service (RFC-0103) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- The ongoing notification is a real UI surface (RFC-0103), not optional chrome -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declare the custom handshake permission for this app's own use -->
    <uses-permission android:name="fi.italeino.aidos.engine.HANDSHAKE" />

    <!-- Optional for voice/STT features (M33) -->
    <!-- <uses-permission android:name="android.permission.RECORD_AUDIO" /> -->

    <application
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.AidosEngine">

        <!-- Main activity for Aidos Engine UI (RFC-0103) -->
        <activity
            android:name="fi.italeino.aidos.engine.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link for model acquisition (RFC-0103): client apps navigate here directly
                 rather than rendering their own download UI. Matches the navDeepLink declared on
                 EngineRoute.ModelDetail in NavHost.kt. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aidosengine" android:host="model" />
            </intent-filter>
        </activity>

        <!-- Foreground service for Engine (RFC-0103). Hosts the Engine core (model loading,
             inference) in-process. Exposes an HTTP server on loopback + Binder handshake. -->
        <service
            android:name="fi.italeino.aidos.engine.EngineService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="fi.italeino.aidos.engine.HANDSHAKE">
            <!-- Binder handshake interface (RFC-0103): signature-protected by permission above -->
            <intent-filter>
                <action android:name="fi.italeino.aidos.engine.HANDSHAKE" />
            </intent-filter>
        </service>

    </application>

</manifest>
