<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core permissions for Git remotes, voice capture, and offline operation (RFC-0050) -->
    <!-- Storage permissions are deliberately omitted: projects live in app-private storage. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Package visibility for local device STT (SpeechRecognizer) and TTS (TextToSpeech) on API 30+ -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    
    <!-- Required for foreground service (M27: RuntimeServiceHost, RFC-0050) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Ongoing notification UI surface (RFC-0050) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:usesCleartextTraffic="false">

        <!-- Launcher 1 (RFC-0111): Aidos Life (Personal / Life Workspace) -->
        <activity
            android:name="fi.italeino.aidos.LifeMainActivity"
            android:exported="true"
            android:taskAffinity="fi.italeino.aidos.life"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:label="Aidos Life">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launcher 2 (RFC-0111): Aidos Workspace (Development / Coding Workspace) -->
        <activity
            android:name="fi.italeino.aidos.MainActivity"
            android:exported="true"
            android:taskAffinity="fi.italeino.aidos.workspace"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:label="Aidos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Project Document Launcher (RFC-0111): Concurrent Document Tasks in Recents -->
        <activity
            android:name="fi.italeino.aidos.ProjectActivity"
            android:exported="true"
            android:documentLaunchMode="intoExisting"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:label="Aidos Project">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aidos" android:host="project" />
            </intent-filter>
        </activity>

        <!-- Foreground service for runtime (RFC-0050) -->
        <service
            android:name="fi.italeino.aidos.service.AidosService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- System Assistant Service (RFC-0111 §1.2): Power button / corner swipe -->
        <service
            android:name="fi.italeino.aidos.assistant.AidosVoiceInteractionService"
            android:label="Aidos Assistant"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name="fi.italeino.aidos.assistant.AidosVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="false" />

    </application>

</manifest>
